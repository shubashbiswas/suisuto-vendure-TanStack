{
  "name": "@suisuto/vendure-geoip-plugin",
  "version": "1.0.0",
  "description": "Production-ready, modular hybrid GeoIP (MaxMind MMDB + IP-API fallback) plugin for Vendure",
  "author": "Suisuto",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "dashboard"
  ],
  "scripts": {
    "build": "tsc",
    "test": "ts-node -T tests/geoip.spec.ts"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/graphql": ">=12.0.0",
    "@vendure/core": ">=3.7.3",
    "@vendure/dashboard": ">=3.7.3"
  },
  "dependencies": {
    "graphql-tag": "^2.12.7",
    "lucide-react": "^0.536.0",
    "maxmind": "^4.3.24"
  },
  "devDependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/graphql": "13.1.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vendure/core": "^3.7.3",
    "@vendure/dashboard": "^3.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-node": "10.9.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "vendure",
    "vendure-plugin",
    "geoip",
    "maxmind",
    "geolocation",
    "ip-api",
    "dashboard"
  ]
}

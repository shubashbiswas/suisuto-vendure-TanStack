{
  "name": "storefront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3001",
    "generate:i18n": "node scripts/compile-i18n.mjs",
    "generate": "npm run generate:i18n",
    "build": "npm run generate:i18n && vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "check-types": "npm run generate && tsc --noEmit",
    "commitlint": "commitlint --verbose",
    "prepare": "husky",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:e2e": "npm run generate:i18n && playwright test",
    "upgrade:init": "node scripts/storefront-upgrade.mjs init",
    "upgrade:prepare": "node scripts/storefront-upgrade.mjs prepare",
    "upgrade:verify": "node scripts/storefront-upgrade.mjs verify",
    "upgrade:finalize": "node scripts/storefront-upgrade.mjs finalize",
    "upgrade:validate": "node scripts/validate-upgrades.mjs",
    "upgrade:release": "node scripts/storefront-release.mjs",
    "start": "node .output/server/index.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@inlang/paraglide-js": "^2.25.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.57",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "gql.tada": "^1.11.3",
    "graphql": "^16.14.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.536.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-resizable-panels": "^4.13.2",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@inlang/plugin-icu1": "1.1.0",
    "@inlang/plugin-m-function-matcher": "2.2.12",
    "@playwright/test": "^1.63.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "husky": "^9.1.7",
    "tar": "^7.5.22",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}

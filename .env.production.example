# ==============================================================================
# Suisuto Production Environment Variables
# Copy to .env.production on your production server:
#   cp .env.production.example .env.production
# ==============================================================================

# GitHub Container Registry (GHCR) settings
GHCR_OWNER=shubashbiswas
VERSION_TAG=latest

# Domain Names & Reverse Proxy (Traefik)
STOREFRONT_DOMAIN=suisuto.com
API_DOMAIN=api.suisuto.com

# PostgreSQL Database
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=replace_with_strong_production_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Vendure Security & Admin
COOKIE_SECRET=replace_with_a_random_32_character_string_here
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace_with_strong_superadmin_password_here

# CORS & Asset Delivery
CORS_ORIGINS=https://suisuto.com,https://api.suisuto.com
ASSET_URL_PREFIX=https://api.suisuto.com/assets/

# Database Synchronize (ALWAYS false in production — use migrations!)
DB_SYNCHRONIZE=false

# Storefront Settings
VENDURE_SHOP_API_URL=http://server:3000/shop-api
VENDURE_CHANNEL_TOKEN=__default_channel__
VITE_SITE_URL=https://suisuto.com
